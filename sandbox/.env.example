PORT=7860
# Shared secret the API must send as `Authorization: Bearer <token>`.
# Leave empty only for local development; always set it in production.
SANDBOX_AUTH_TOKEN=
SANDBOX_WORKSPACE_ROOT=/workspace
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
# 0 disables the per-command CPU-seconds rlimit (wall-clock timeout is primary).
SANDBOX_CPU_SECONDS=0
# 0 disables the RLIMIT_AS memory rlimit (container cgroup memory is the cap).
SANDBOX_MEMORY_BYTES=0
SANDBOX_FSIZE_BYTES=524288000
SANDBOX_NOFILE_LIMIT=4096
SANDBOX_MAX_OUTPUT_CHARS=20000
SANDBOX_IDLE_TIMEOUT_SECONDS=3600
