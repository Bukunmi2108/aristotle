VITE_AGENT_HTTP_BASE_URL=https://aristotle-api.duckdns.org
VITE_AGENT_WS_BASE_URL=wss://aristotle-api.duckdns.org
# Optional separate origin for HTML artifact previews (defence-in-depth so
# agent-generated pages never load from the app origin). Defaults to the API
# origin, which is still isolated via the iframe sandbox. Point at e.g.
# https://aristotle-preview.duckdns.org and route it to the API in Caddy.
# VITE_PREVIEW_ORIGIN=
