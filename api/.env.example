PORT=7860
CORS_ALLOW_ORIGINS=*
PRIMARY_MODEL_BASE_URL=https://api-inference.modelscope.ai/v1
PRIMARY_MODEL_NAME=Qwen/Qwen3-235B-A22B-Instruct-2507
MODELSCOPE_API_KEY=
MODEL_FALLBACK_ENABLED=true
FALLBACK_MODEL_BASE_URL=https://bukunmi2108-aristotle-model.hf.space/v1
FALLBACK_MODEL_NAME=/models/NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf
FALLBACK_MODEL_API_KEY=unused
ARISTOTLE_SEARCH_BASE_URL=https://bukunmi2108-aristotle-search.hf.space
WAKE_TIMEOUT_SECONDS=180
WAKE_POLL_INTERVAL_SECONDS=3
MODEL_REQUEST_TIMEOUT_SECONDS=180
SEARCH_REQUEST_TIMEOUT_SECONDS=30
WEB_FETCH_TIMEOUT_SECONDS=20
AGENT_TEMPERATURE=0.2
DATABASE_URL=
# The API refuses to start on a blank DATABASE_URL rather than silently using an
# in-container database whose data is lost on every restart/redeploy. For a
# throwaway local run without a real database, set ALLOW_EPHEMERAL_DB=true.
# ALLOW_EPHEMERAL_DB=true
RESET_DB_ON_START=false
DATA_RETENTION_DAYS=7
# Workspace / sandbox service. The API reaches the private sandbox by container
# name over the internal network. SANDBOX_SERVICE_TOKEN here must equal
# SANDBOX_AUTH_TOKEN in the sandbox service's environment.
WORKSPACE_ENABLED=true
SANDBOX_SERVICE_BASE_URL=http://workspace-aristotle-sandbox:7860
SANDBOX_SERVICE_TOKEN=
# Same secret as the sandbox's SANDBOX_AUTH_TOKEN (single value, both services).
SANDBOX_AUTH_TOKEN=
SANDBOX_REQUEST_TIMEOUT_SECONDS=30
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
