#!/usr/bin/env bash
# Repository-owned production release logic, executed from an exact checkout.
set -euo pipefail

APP_DIR="/opt/workspace/apps/aristotle-api"
SOURCE_DIR="$APP_DIR/source"
COMPOSE_FILE="$SOURCE_DIR/api/deploy/compose.production.yaml"
API_CONTAINER="workspace-aristotle-api"
SANDBOX_CONTAINER="workspace-aristotle-sandbox"

SHA="${1:?usage: release <git-sha>}"

if [ "$(git -C "$SOURCE_DIR" rev-parse HEAD)" != "$SHA" ]; then
  echo "ERROR: source checkout does not match requested revision $SHA" >&2
  exit 1
fi

services="$(
  APP_SOURCE_ROOT="./source" \
  APP_ENV_FILE="./.env" \
  APP_IMAGE_TAG="$SHA" \
    docker compose -f "$COMPOSE_FILE" --project-directory "$APP_DIR" config --services
)"
for required_service in backend sandbox; do
  if ! grep -qx "$required_service" <<<"$services"; then
    echo "ERROR: production Compose is missing required service: $required_service" >&2
    exit 1
  fi
done

cd "$APP_DIR"
APP_SOURCE_ROOT="./source" \
APP_ENV_FILE="./.env" \
APP_IMAGE_TAG="$SHA" \
  docker compose -f "$COMPOSE_FILE" --project-directory "$APP_DIR" \
  up -d --build backend sandbox

wait_healthy() {
  local container="$1"
  local attempts=30
  echo "Waiting for $container to become healthy..."
  for attempt in $(seq 1 "$attempts"); do
    health="$(docker inspect --format '{{.State.Health.Status}}' "$container" 2>/dev/null || echo missing)"
    if [ "$health" = "healthy" ]; then
      echo "$container is healthy"
      return 0
    fi
    run_state="$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null || echo missing)"
    if [ "$run_state" = "exited" ] || [ "$run_state" = "dead" ]; then
      exit_code="$(docker inspect --format '{{.State.ExitCode}}' "$container" 2>/dev/null || echo '?')"
      echo "ERROR: $container $run_state before becoming healthy (exit code $exit_code)" >&2
      docker logs --tail 100 "$container" >&2 || true
      return 1
    fi
    if [ "$attempt" -eq "$attempts" ]; then
      echo "ERROR: $container did not become healthy (status: $run_state, health: $health)" >&2
      docker logs --tail 100 "$container" >&2 || true
      return 1
    fi
    sleep 5
  done
}

wait_healthy "$API_CONTAINER"
wait_healthy "$SANDBOX_CONTAINER"

docker exec "$API_CONTAINER" python3 -m app.workspace_smoke

docker image prune -f >/dev/null 2>&1 || true

echo "Deployed aristotle-api and sandbox at $SHA"
